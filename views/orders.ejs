<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>My Orders - CodeAlpha Store</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="container">
    <h1>My Orders</h1>

    <% if (orders.length === 0) { %>
      <p>You haven't placed any orders yet.</p>
    <% } else { %>
      <% orders.forEach(order => { %>
        <div class="order-card">
          <p><strong>Order ID:</strong> <%= order._id %></p>
          <p><strong>Date:</strong> <%= order.createdAt.toDateString() %></p>
          <p><strong>Status:</strong> <%= order.status %></p>
          <ul>
            <% order.items.forEach(item => { %>
              <li><%= item.name %> &times; <%= item.quantity %> - $<%= (item.price * item.quantity).toFixed(2) %></li>
            <% }) %>
          </ul>
          <p><strong>Total: $<%= order.totalAmount.toFixed(2) %></strong></p>
        </div>
      <% }) %>
    <% } %>
  </main>
</body>
</html>
