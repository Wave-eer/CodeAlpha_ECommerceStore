<!DOCTYPE html>
<html lang=\"en\">
<head>
  <meta charset=\"UTF-8\">
  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">
  <title>My Orders — Halo Market</title>
  <link rel=\"stylesheet\" href=\"/css/style.css\">
  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">
  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>
  <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap\" rel=\"stylesheet\">
</head>
<body>
  <%- include('partials/navbar') %>

  <main class=\"container orders-page-container\">
    <div class=\"page-header-simple\">
      <h1 class=\"section-heading\">Order History</h1>
      <p class=\"section-subtitle\">Review and track your past purchases with Halo Market</p>
    </div>

    <% if (orders.length === 0) { %>
      <div class=\"empty-cart-card\">
        <div class=\"empty-cart-icon\">📦</div>
        <h2>No orders placed yet</h2>
        <p>When you complete a purchase, your order status and items will be displayed here.</p>
        <a href=\"/\" class=\"btn btn-primary\">Browse Products</a>
      </div>
    <% } else { %>
      <div class=\"orders-list\">
        <% orders.forEach(order => { %>
          <article class=\"order-card-modern\">
            <div class=\"order-card-header\">
              <div class=\"order-id-date\">
                <span class=\"order-ref\">Order #<%= order._id.toString().slice(-8).toUpperCase() %></span>
                <span class=\"order-date\"><%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
              </div>
              <div class=\"order-header-right\">
                <span class=\"status-pill status-<%= (order.status || 'processing').toLowerCase() %>\">
                  ● <%= order.status || 'Processing' %>
                </span>
              </div>
            </div>

            <div class=\"order-card-body\">
              <div class=\"order-items-table\">
                <% (order.items || []).forEach(item => { %>
                  <div class=\"order-item-row\">
                    <div class=\"order-item-main\">
                      <span class=\"item-name\"><strong><%= item.name %></strong></span>
                      <span class=\"item-meta\">Qty: <%= item.quantity %> &times; $<%= item.price.toFixed(2) %></span>
                    </div>
                    <span class=\"item-total\">$<%= (item.price * item.quantity).toFixed(2) %></span>
                  </div>
                <% }) %>
              </div>
            </div>

            <div class=\"order-card-footer\">
              <div class=\"order-total-block\">
                <span>Total Paid:</span>
                <strong>$<%= Number(order.totalAmount || 0).toFixed(2) %></strong>
              </div>
              <a href=\"/\" class=\"btn btn-sm-add\">Shop Again</a>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
