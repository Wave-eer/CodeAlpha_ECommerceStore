<!DOCTYPE html>
<html lang=\"en\">
<head>
  <meta charset=\"UTF-8\">
  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">
  <title><%= product.name %> — Halo Market</title>
  <link rel=\"stylesheet\" href=\"/css/style.css\">
  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">
  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>
  <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap\" rel=\"stylesheet\">
</head>
<body>
  <%- include('partials/navbar') %>

  <main class=\"container product-page-container\">
    <!-- Breadcrumb Navigation -->
    <nav class=\"breadcrumbs\" aria-label=\"Breadcrumb\">
      <a href=\"/\">Home</a>
      <span class=\"crumb-sep\">/</span>
      <a href=\"/?category=<%= product.category || 'all' %>\"><%= (product.category || 'All').toUpperCase() %></a>
      <span class=\"crumb-sep\">/</span>
      <span class=\"crumb-current\"><%= product.name %></span>
    </nav>

    <!-- Product Main Card -->
    <div class=\"product-detail-layout\">
      <div class=\"product-gallery-side\">
        <div class=\"detail-image-box\">
          <img src=\"<%= product.imageUrl %>\" alt=\"<%= product.name %>\" onerror=\"this.src='https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=700&q=80'\">
          <% if (product.badge) { %>
            <span class=\"product-badge-lg\"><%= product.badge %></span>
          <% } %>
        </div>
      </div>

      <div class=\"product-summary-side\">
        <div class=\"detail-header\">
          <span class=\"category-pill-sm\"><%= (product.category || 'General').toUpperCase() %></span>
          <div class=\"detail-rating\">
            <span class=\"stars\">★★★★★</span>
            <span class=\"score\"><%= product.rating || 4.8 %> (<%= product.reviewsCount || 48 %> customer reviews)</span>
          </div>
        </div>

        <h1 class=\"detail-title\"><%= product.name %></h1>

        <div class=\"detail-price-box\">
          <span class=\"price-lg\">$<%= product.price.toFixed(2) %></span>
          <% if (product.originalPrice && product.originalPrice > product.price) { %>
            <span class=\"price-original-lg\">$<%= product.originalPrice.toFixed(2) %></span>
            <span class=\"discount-pill\">Save $<%= (product.originalPrice - product.price).toFixed(2) %></span>
          <% } %>
        </div>

        <p class=\"detail-description\"><%= product.description %></p>

        <% if (product.features && product.features.length > 0) { %>
          <div class=\"features-checklist\">
            <h4>Key Highlights</h4>
            <ul>
              <% product.features.forEach(feat => { %>
                <li>
                  <span class=\"check-icon\">✓</span>
                  <span><%= feat %></span>
                </li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <div class=\"stock-indicator <%= product.stock > 0 ? 'in-stock' : 'out-of-stock' %>\">
          <span class=\"stock-dot\"></span>
          <span><%= product.stock > 0 ? ('In Stock (' + product.stock + ' units available)') : 'Currently Out of Stock' %></span>
        </div>

        <!-- Add to Cart Form -->
        <form action=\"/cart/add/<%= product._id %>\" method=\"POST\" class=\"detail-action-form\">
          <div class=\"qty-picker\">
            <label for=\"quantity\">Quantity</label>
            <div class=\"qty-stepper\">
              <button type=\"button\" onclick=\"decrementQty()\" class=\"stepper-btn\" aria-label=\"Decrease quantity\">-</button>
              <input type=\"number\" id=\"quantity\" name=\"quantity\" value=\"1\" min=\"1\" max=\"<%= product.stock || 99 %>\" readonly>
              <button type=\"button\" onclick=\"incrementQty(<%= product.stock || 99 %>)\" class=\"stepper-btn\" aria-label=\"Increase quantity\">+</button>
            </div>
          </div>

          <div class=\"button-group-actions\">
            <button type=\"submit\" class=\"btn btn-primary btn-add-main\">
              <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">
                <circle cx=\"9\" cy=\"21\" r=\"1\"></circle>
                <circle cx=\"20\" cy=\"21\" r=\"1\"></circle>
                <path d=\"M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6\"></path>
              </svg>
              <span>Add to Cart</span>
            </button>
            <button type=\"submit\" name=\"buyNow\" value=\"true\" class=\"btn btn-amber btn-buy-now\">
              Buy Now
            </button>
          </div>
        </form>

        <div class=\"guarantee-icons-row\">
          <div class=\"g-item\"><span>📦</span> Fast Insured Dispatch</div>
          <div class=\"g-item\"><span>🛡️</span> 1-Year Warranty Included</div>
          <div class=\"g-item\"><span>↩️</span> 30-Day Returns</div>
        </div>
      </div>
    </div>

    <!-- Related Products -->
    <% if (typeof relatedProducts !== 'undefined' && relatedProducts.length > 0) { %>
      <section class=\"related-section\">
        <h3 class=\"section-heading\">You May Also Like</h3>
        <div class=\"product-grid\">
          <% relatedProducts.forEach(rel => { %>
            <article class=\"product-card\">
              <div class=\"product-media\">
                <a href=\"/products/<%= rel._id %>\">
                  <img src=\"<%= rel.imageUrl %>\" alt=\"<%= rel.name %>\" loading=\"lazy\">
                </a>
              </div>
              <div class=\"product-body\">
                <h3 class=\"product-title\"><a href=\"/products/<%= rel._id %>\"><%= rel.name %></a></h3>
                <div class=\"product-footer\">
                  <span class=\"current-price\">$<%= rel.price.toFixed(2) %></span>
                  <a href=\"/products/<%= rel._id %>\" class=\"btn btn-sm-add\">View</a>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      </section>
    <% } %>
  </main>

  <script>
    function decrementQty() {
      const input = document.getElementById('quantity');
      let val = parseInt(input.value) || 1;
      if (val > 1) input.value = val - 1;
    }
    function incrementQty(max) {
      const input = document.getElementById('quantity');
      let val = parseInt(input.value) || 1;
      if (val < max) input.value = val + 1;
    }
  </script>

  <%- include('partials/footer') %>
</body>
</html>
